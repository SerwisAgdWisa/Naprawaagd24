<h2>Zamów Naprawę Pralki</h2>
<form class="order-form" onsubmit="sendToWhatsApp(event)">
<div class="form-group">
<label>Imię:</label>
<input id="name" placeholder="Twoje imię" required="" type="text"/>
</div>
<div class="form-group">
<label>Telefon:</label>
<input id="phone" placeholder="+48 XXX XXX XXX" required="" type="tel"/>
</div>
<div class="form-group">
<label>Marka pralki:</label>
<input id="brand" placeholder="np. Samsung, LG, Bosch" required="" type="text" value="Siemens"/>
</div>
<div class="form-group">
<label>Miasto:</label>
<input id="city" readonly="" type="text" value="Stargard"/>
</div>
<div class="form-group">
<label>Adres:</label>
<input id="address" placeholder="Ulica, numer domu/mieszkania" required="" type="text"/>
</div>
<div class="form-group">
<label>Opis problemu:</label>
<textarea id="message" placeholder="Opisz co się dzieje z pralką..." required="" rows="4"></textarea>
</div>
<button class="submit-btn" type="submit">Wyślij na WhatsApp</button>
</form>
</div>
</section>
